# Dependencies & build output
node_modules/
out/
*.mp4

# Media kept out of the public repo (see README "Local assets")
# Pixabay music: licence forbids redistributing the file
public/audio/
# Coach Nas recordings + generated voice clips
public/voice/
# Coach Nas photo, site screenshots, Gemini images
public/img/
# User video clips
public/clips/

# Local secrets (keys live in user env vars, never in files)
.env
.env.*

# AutoReel working folders (raw footage, renders, per-reel projects stay local)
autoreel/input/*
autoreel/output/*
autoreel/projects/*
public/autoreel/
!autoreel/input/.gitkeep
!autoreel/output/.gitkeep
!autoreel/projects/.gitkeep
